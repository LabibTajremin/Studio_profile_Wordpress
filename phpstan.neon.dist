parameters:
    level: 6
    paths:
        - plugins/maapkathi-core/src
        - themes/maapkathi-theme
    excludePaths:
        - '*/vendor/*'
        # SectionWidget extends Elementor\Widget_Base, which is not on disk
        # here (Elementor is an optional plugin, not a dependency of this
        # one). "extends unknown class" is one of the few errors PHPStan
        # refuses to let ignoreErrors suppress - it says so itself and points
        # at excludePaths - so the thin widget subclasses are excluded
        # outright. Support.php, which only references Elementor classes
        # rather than extending one, stays analysed.
        - plugins/maapkathi-core/src/Elementor/Widgets
    bootstrapFiles:
        - phpstan-bootstrap.php
        - vendor/szepeviktor/phpstan-wordpress/bootstrap.php
    # phpstan-bootstrap.php has to give MK_* deployment constants (driver
    # selectors, admin credentials, etc.) *some* concrete value so the
    # analyser can resolve them at all. Because PHP constants are immutable,
    # PHPStan then treats that one arbitrary value as a literal type for the
    # whole run — which makes a handful of genuinely config-dependent
    # branches look permanently dead/redundant relative to that specific
    # value, even though they are reachable for other real deployments.
    #
    # Which of those branches look dead therefore depends on the values the
    # bootstrap happens to supply, so whether each path below actually
    # produces its error varies between environments — an unmatched pattern
    # here means "this deployment's constants made that branch live", not
    # "the ignore is stale". reportUnmatched is set per entry rather than
    # globally, so any ignore added later is still checked for drift.
    ignoreErrors:
        # The Elementor integration is written against classes that exist
        # only when Elementor is installed. Elementor is an optional plugin
        # an admin may or may not have, not a dependency of this one, and
        # the integration checks for it at runtime before touching any of
        # those symbols (Support::is_available(), which also pins a minimum
        # version). Requiring the whole plugin as a dev dependency purely to
        # satisfy the analyser would be a large download for no added
        # safety, so the unknown-symbol family is ignored for this
        # directory and nowhere else. These are reported if they stop
        # matching, so adding Elementor as a dependency later surfaces them
        # rather than leaving a stale ignore behind.
        -
            message: '#(has invalid type|on an unknown class|extends unknown class) Elementor#'
            paths:
                - plugins/maapkathi-core/src/Elementor
        -
            message: '#^Result of \|\| is always true\.$#'
            reportUnmatched: false
            paths:
                - plugins/maapkathi-core/src/Config/Config.php
                - plugins/maapkathi-core/src/Mail/Mailer.php
        -
            message: '#^Unreachable statement - code above always terminates\.$#'
            reportUnmatched: false
            paths:
                - plugins/maapkathi-core/src/Inquiries/Inquiries.php
                - plugins/maapkathi-core/src/Mail/Mailer.php
includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
