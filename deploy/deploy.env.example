# =====================================================================
# Maapkathi Studio — deployment settings
# =====================================================================
#
# Fill in every value marked CHANGE_ME, then generate wp-config.php:
#
#     php deploy/build-wp-config.php
#
# That writes deploy/wp-config.php — upload it to public_html/ on
# Hostinger as wp-config.php. Secure salts are generated for you.
#
# SECURITY
#   - This file contains passwords. Never commit a filled-in copy.
#   - Never upload this file to the server. Only wp-config.php goes up.
#   - If you do keep it on the server, the shipped .htaccess already
#     blocks .env files from being served — but don't rely on that.
# =====================================================================


# ---------------------------------------------------------------------
# 1. DATABASE  —  hPanel → Databases → Management → Create new database
# ---------------------------------------------------------------------
# Hostinger prefixes these, e.g. u123456789_maapkathi
DB_NAME=CHANGE_ME
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# Almost always localhost on Hostinger. Only change if hPanel says otherwise.
DB_HOST=localhost

# Keep whatever the WordPress installer generated. A random prefix is good
# for security — do not "tidy" it to wp_ if the installer chose something else.
DB_TABLE_PREFIX=wp_


# ---------------------------------------------------------------------
# 2. SITE
# ---------------------------------------------------------------------
# Full public URL, no trailing slash. Use https:// once SSL is active.
SITE_URL=https://CHANGE_ME.com


# ---------------------------------------------------------------------
# 3. FIRST ADMIN ACCOUNT
# ---------------------------------------------------------------------
# Legacy / optional. The first admin is now set up on-site instead: the
# moment the WordPress installer's own admin first opens wp-admin, they're
# walked through a one-time "Maapkathi Setup" screen (username, email,
# password, full name) — no wp-config.php editing needed.
#
# Leave ADMIN_ENABLED=false unless you specifically need to pre-seed an
# admin account non-interactively (e.g. an automated deploy with no one
# available to click through the setup screen).
ADMIN_ENABLED=false
ADMIN_USERNAME=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
ADMIN_EMAIL=CHANGE_ME@example.com
ADMIN_NAME=Studio Admin


# ---------------------------------------------------------------------
# 4. MAAPKATHI CONFIGURATION
# ---------------------------------------------------------------------
# Storage driver: 1 S3 · 2 Google Drive · 3 Local (SHIPPED) · 4 R2
#                 5 Supabase · 6 Bunny
# Leave at 3 unless you are deliberately moving media off the host disk.
MK_STORAGE_DRIVER=3

# Video driver: 0 = same as storage (SHIPPED)
MK_VIDEO_DRIVER=0

# Cache: 1 transients · 2 Redis object cache
MK_CACHE_DRIVER=1

# Mail: 0 inbox only (SHIPPED) · 1 SMTP · 2 external API
# 0 means contact-form submissions are stored and read in the admin
# Enquiries inbox, with no outbound email — but that also means email
# verification links and password-recovery emails (section 5 below)
# never send. Set this to 1 and fill in MK_SMTP_* to enable them.
MK_MAIL_DRIVER=0

# Upload ceilings, enforced server-side (bytes).
MK_MAX_VIDEO_BYTES=209715200
MK_MAX_IMAGE_BYTES=10485760
MK_MAX_GIF_BYTES=8388608
MK_CHUNK_BYTES=2097152

# Hero carousel timing (seconds). Admin-editable later on the Hero screen.
MK_HERO_SLIDE_SECONDS=6
MK_MAX_HERO_HOLD_SECONDS=20


# ---------------------------------------------------------------------
# 5. OUTBOUND EMAIL — sender identity + SMTP
# ---------------------------------------------------------------------
# Sender shown on every email the site sends (verification links, password
# resets, enquiry notifications). Leave blank to use WordPress's own default.
MK_MAIL_FROM_EMAIL=info@maapkathi.com
MK_MAIL_FROM_NAME=Maapkathi Studio

# Only used when MK_MAIL_DRIVER=1 above. Hostinger's SMTP is usually
# smtp.hostinger.com : 587 (STARTTLS) with your full mailbox address as
# the username — check hPanel → Emails for the exact host if unsure.
MK_SMTP_HOST=CHANGE_ME
MK_SMTP_PORT=587
MK_SMTP_USERNAME=CHANGE_ME
MK_SMTP_PASSWORD=CHANGE_ME
# tls | ssl
MK_SMTP_ENCRYPTION=tls


# ---------------------------------------------------------------------
# 6. ENVIRONMENT
# ---------------------------------------------------------------------
# production | staging | development
# production forces debug output off regardless of the flags below.
WP_ENVIRONMENT=production

# Only ever set true on a staging copy. Never on a live site.
WP_DEBUG=false

# Set true once the Hostinger SSL certificate is active for the domain.
FORCE_SSL_ADMIN=true

# PHP memory. 256M is comfortable on Hostinger Premium.
WP_MEMORY_LIMIT=256M
